<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cardsmethoddatabase.controllers.MainFormController">
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <VBox fx:id="vBoxForCards" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" style="-fx-border-color: red;">
            <children>
               <Label fx:id="labelWord" text="Word">
                  <font>
                     <Font name="Monospaced Regular" size="24.0" />
                  </font>
               </Label>
               <Label fx:id="labelTranscription" text="Transcription">
                  <font>
                     <Font name="Monospaced Regular" size="18.0" />
                  </font>
               </Label>
               <Label fx:id="translationLabel" text="Translation" visible="false">
                  <font>
                     <Font name="Monospaced Regular" size="18.0" />
                  </font>
               </Label>
               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <Button fx:id="wrongButton" mnemonicParsing="false" onAction="#onWrongAnswer" style="-fx-background-color: #f26754;" text="◀" />
                     <ToggleButton fx:id="magicButton" mnemonicParsing="false" onAction="#onShowInfo" text="Show me a secret!">
                        <font>
                           <Font name="Monospaced Regular" size="16.0" />
                        </font></ToggleButton>
                     <Button fx:id="correctButton" mnemonicParsing="false" onAction="#onCorrectAnswer" style="-fx-background-color: #bfd85b;" text="▶" />
                  </children>
               </HBox>
            </children></VBox>
         <HBox fx:id="hBoxForBoxes" alignment="CENTER" onMouseEntered="#onMouseEntered" prefHeight="100.0" prefWidth="200.0" spacing="15.0" style="-fx-border-color: orange;" />
      </children></VBox>
</AnchorPane>
